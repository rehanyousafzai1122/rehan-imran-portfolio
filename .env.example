# Firebase config — get these from:
# Firebase Console > Project Settings (gear icon) > General > "Your apps" > Web app
# See src/lib/firebase.ts for the one-time setup steps.
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# The email you create under Firebase Console > Authentication > Users.
# The admin panel login still asks for just a password — it signs in with
# this email behind the scenes.
VITE_ADMIN_EMAIL="admin@rehanimran.dev"
