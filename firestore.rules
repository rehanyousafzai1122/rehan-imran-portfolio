rules_version = '2';

// Paste this into Firebase Console -> Firestore Database -> Rules.
//
// Anyone visiting the portfolio can READ the shared document (that's how
// every visitor sees the same up-to-date content). Only a signed-in admin
// (the one account you create under Authentication -> Users) can WRITE to it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolioSite/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
